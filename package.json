{
  "name": "live-chat-phrases",
  "version": "0.0.0",
  "private": true,
  "description": "Live chat phrase menu extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
